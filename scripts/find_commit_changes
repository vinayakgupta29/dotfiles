
#!/usr/bin/env bash

# find_commit_changes script searches a directory recursively 
# for Git repositories and prints the paths of repositories that 
# have uncommitted changes or saved stashes.

set -Eeuo pipefail

root_dir="${1:-.}"
root_dir="$(realpath "$root_dir")"

find "$root_dir" -type d -name .git -print0 |
while IFS= read -r -d '' gitdir; do
    repo_dir="${gitdir%/.git}"

    status=$(git -C "$repo_dir" status --porcelain 2>/dev/null)
    stashes=$(git -C "$repo_dir" stash list 2>/dev/null)

    if [[ -n "$status" || -n "$stashes" ]]; then
        printf '%s\n' "$repo_dir"
    fi
done
